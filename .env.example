# Server Configuration
PORT=5400
NODE_ENV=Development|Staging|Production

# Database Configuration
# Local machine: mongodb://localhost:27017/subscription-tracker
# Docker compose: mongodb://mongo:27017/subscription-tracker
DB_URI=mongodb://mongo:27017/subscription-tracker

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d
ADMIN_kEY=your_admin_secret_key_here

# Nodemailer / Email Service
EMAIL_ACCOUNT=your_email@gmail.com
EMAIL_PASSWORD=your_app_password